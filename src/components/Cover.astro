---
// Abstract, theme-aware SVG cover art. Each motif is drawn with the site's
// lavender CSS variables, so it adapts to light/dark automatically and needs
// no external image assets. Decorative only (aria-hidden).
import type { Motif, SectionId } from '../motifs';

interface Props {
  motif: Motif;
  /** Section id — tints the art with that section's accent hue. Optional. */
  tint?: SectionId;
  class?: string;
}
const { motif, tint, class: className } = Astro.props;
---

<div class:list={['cover', tint && `tint-${tint}`, className]} aria-hidden="true">
  <svg viewBox="0 0 1200 380" preserveAspectRatio="xMidYMid slice" role="presentation">
    <defs>
      <linearGradient id="cover-bg" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="var(--surface)"></stop>
        <stop offset="1" stop-color="var(--bg-elev)"></stop>
      </linearGradient>
      <radialGradient id="cover-glow" cx="0.78" cy="0.22" r="0.9">
        <stop offset="0" stop-color="var(--cover-accent)" stop-opacity="0.16"></stop>
        <stop offset="1" stop-color="var(--cover-accent)" stop-opacity="0"></stop>
      </radialGradient>
    </defs>
    <rect width="1200" height="380" fill="url(#cover-bg)"></rect>
    <rect width="1200" height="380" fill="url(#cover-glow)"></rect>

    {
      motif === 'config' && (
        <g fill="none" stroke="var(--cover-accent)" stroke-width="2.5">
          <g stroke-opacity="0.35">
            <path d="M330 130 H560" />
            <path d="M330 190 H560" />
            <path d="M330 250 H560" />
            <path d="M640 190 H860" />
          </g>
          <g fill="var(--cover-accent)" stroke="none">
            <rect x="150" y="110" width="180" height="42" rx="9" fill-opacity="0.55" />
            <rect x="150" y="169" width="180" height="42" rx="9" fill-opacity="0.35" />
            <rect x="150" y="228" width="180" height="42" rx="9" fill-opacity="0.55" />
          </g>
          <polygon
            points="560,130 640,130 680,190 640,250 560,250 520,190"
            fill="var(--cover-accent)"
            fill-opacity="0.14"
            stroke="var(--cover-accent)"
            stroke-opacity="0.7"
          />
          <g fill="var(--cover-accent)" stroke="none">
            <rect x="860" y="118" width="150" height="36" rx="8" fill-opacity="0.5" />
            <rect x="860" y="172" width="150" height="36" rx="8" fill-opacity="0.5" />
            <rect x="860" y="226" width="150" height="36" rx="8" fill-opacity="0.5" />
          </g>
        </g>
      )
    }

    {
      motif === 'network' && (
        <g>
          <g fill="none" stroke="var(--cover-accent)" stroke-width="2.5" stroke-opacity="0.4">
            <path d="M600 190 L360 90" />
            <path d="M600 190 L330 210" />
            <path d="M600 190 L380 300" />
            <path d="M600 190 L850 100" />
            <path d="M600 190 L880 220" />
            <path d="M600 190 L820 300" />
            <path d="M360 90 Q600 20 850 100" stroke-dasharray="6 8" stroke-opacity="0.55" />
            <path d="M380 300 Q600 360 820 300" stroke-dasharray="6 8" stroke-opacity="0.55" />
          </g>
          <g fill="var(--cover-accent)">
            <circle cx="360" cy="90" r="16" fill-opacity="0.55" />
            <circle cx="330" cy="210" r="16" fill-opacity="0.55" />
            <circle cx="380" cy="300" r="16" fill-opacity="0.55" />
            <circle cx="850" cy="100" r="16" fill-opacity="0.55" />
            <circle cx="880" cy="220" r="16" fill-opacity="0.55" />
            <circle cx="820" cy="300" r="16" fill-opacity="0.55" />
          </g>
          <circle cx="600" cy="190" r="44" fill="var(--cover-accent)" fill-opacity="0.7" />
          <circle cx="600" cy="190" r="60" fill="none" stroke="var(--cover-accent)" stroke-opacity="0.35" stroke-width="2.5" />
        </g>
      )
    }

    {
      motif === 'pipeline' && (
        <g fill="none" stroke="var(--cover-accent)" stroke-width="2.5">
          <g stroke-opacity="0.4">
            <path d="M250 190 H480" />
            <path d="M540 160 C620 120 680 120 760 120" />
            <path d="M540 220 C620 260 680 260 760 260" />
            <path d="M840 120 C920 120 940 170 990 190" />
            <path d="M840 260 C920 260 940 210 990 190" />
          </g>
          <circle cx="220" cy="190" r="26" fill="var(--cover-accent)" fill-opacity="0.6" stroke="none" />
          <polygon
            points="510,150 540,190 510,230 480,190"
            fill="var(--cover-accent)"
            fill-opacity="0.16"
            stroke="var(--cover-accent)"
            stroke-opacity="0.7"
          />
          <g fill="var(--cover-accent)" stroke="none">
            <rect x="760" y="98" width="90" height="44" rx="9" fill-opacity="0.5" />
            <rect x="760" y="238" width="90" height="44" rx="9" fill-opacity="0.5" />
          </g>
          <circle cx="1010" cy="190" r="26" fill="var(--cover-accent)" fill-opacity="0.6" stroke="none" />
        </g>
      )
    }

    {
      motif === 'rollout' && (
        <g>
          <g fill="none" stroke="var(--cover-accent)" stroke-width="2.5" stroke-opacity="0.4">
            <path d="M300 330 A170 170 0 0 1 470 160" />
            <path d="M300 330 A250 250 0 0 1 550 80" />
            <path d="M300 330 A320 320 0 0 1 620 10" />
          </g>
          <g fill="var(--cover-accent)" stroke="none">
            <rect x="720" y="250" width="70" height="80" rx="10" fill-opacity="0.35" />
            <rect x="810" y="205" width="70" height="125" rx="10" fill-opacity="0.45" />
            <rect x="900" y="160" width="70" height="170" rx="10" fill-opacity="0.55" />
            <rect x="990" y="110" width="70" height="220" rx="10" fill-opacity="0.7" />
          </g>
          <path
            d="M300 330 h760"
            stroke="var(--cover-accent)"
            stroke-width="2.5"
            stroke-opacity="0.5"
            fill="none"
          />
          <path
            d="M300 300 l22 22 l40 -46"
            fill="none"
            stroke="var(--cover-accent)"
            stroke-width="4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </g>
      )
    }

    {
      motif === 'cloud' && (
        <g>
          <g fill="var(--cover-accent)">
            <path
              d="M360 250 a70 70 0 0 1 10 -139 a90 90 0 0 1 172 -10 a60 60 0 0 1 8 149 Z"
              fill-opacity="0.4"
            />
            <path
              d="M700 285 a70 70 0 0 1 10 -139 a90 90 0 0 1 172 -10 a60 60 0 0 1 8 149 Z"
              fill-opacity="0.6"
            />
          </g>
          <g fill="none" stroke="var(--cover-accent)" stroke-width="2.5" stroke-opacity="0.5" stroke-dasharray="4 9" stroke-linecap="round">
            <path d="M470 200 H770" />
          </g>
          <g fill="var(--cover-accent)">
            <circle cx="470" cy="200" r="9" />
            <circle cx="770" cy="200" r="9" />
          </g>
        </g>
      )
    }

    {
      motif === 'ai' && (
        <g>
          <g fill="none" stroke="var(--cover-accent)" stroke-width="2" stroke-opacity="0.35">
            <path d="M340 120 L600 90 M340 120 L600 190 M340 120 L600 290" />
            <path d="M340 260 L600 90 M340 260 L600 190 M340 260 L600 290" />
            <path d="M600 90 L860 190 M600 190 L860 190 M600 290 L860 190" />
          </g>
          <g fill="var(--cover-accent)">
            <circle cx="340" cy="120" r="18" fill-opacity="0.5" />
            <circle cx="340" cy="260" r="18" fill-opacity="0.5" />
            <circle cx="600" cy="90" r="18" fill-opacity="0.6" />
            <circle cx="600" cy="190" r="18" fill-opacity="0.6" />
            <circle cx="600" cy="290" r="18" fill-opacity="0.6" />
            <circle cx="860" cy="190" r="24" fill-opacity="0.75" />
          </g>
        </g>
      )
    }

    {
      motif === 'code' && (
        <g fill="none" stroke="var(--cover-accent)" stroke-linecap="round" stroke-linejoin="round">
          <g stroke-width="5" stroke-opacity="0.7">
            <polyline points="470,120 380,190 470,260" />
            <polyline points="730,120 820,190 730,260" />
            <path d="M560 275 L640 105" />
          </g>
          <g stroke="var(--cover-accent)" stroke-width="12" stroke-opacity="0.28" stroke-linecap="round">
            <path d="M900 130 H1040" />
            <path d="M900 190 H1010" />
            <path d="M900 250 H1050" />
          </g>
        </g>
      )
    }

    {
      motif === 'book' && (
        <g>
          <g fill="var(--cover-accent)" fill-opacity="0.14" stroke="var(--cover-accent)" stroke-opacity="0.7" stroke-width="2.5">
            <path d="M600 118 C520 94 430 94 360 118 L360 282 C430 258 520 258 600 282 Z" />
            <path d="M600 118 C680 94 770 94 840 118 L840 282 C770 258 680 258 600 282 Z" />
          </g>
          <path d="M600 118 V282" stroke="var(--cover-accent)" stroke-width="2.5" stroke-opacity="0.5" />
          <g stroke="var(--cover-accent)" stroke-width="2.5" stroke-opacity="0.4" stroke-linecap="round">
            <path d="M410 152 H560" />
            <path d="M410 188 H560" />
            <path d="M410 224 H540" />
            <path d="M640 152 H790" />
            <path d="M640 188 H790" />
            <path d="M640 224 H760" />
          </g>
        </g>
      )
    }

    {
      motif === 'leadership' && (
        <g>
          <circle cx="600" cy="190" r="118" fill="none" stroke="var(--cover-accent)" stroke-opacity="0.35" stroke-width="2.5" />
          <g stroke="var(--cover-accent)" stroke-opacity="0.5" stroke-width="2.5" stroke-linecap="round">
            <path d="M600 74 V98" />
            <path d="M600 282 V306" />
            <path d="M484 190 H508" />
            <path d="M692 190 H716" />
          </g>
          <polygon points="600,108 632,210 600,184 568,210" fill="var(--cover-accent)" fill-opacity="0.7" />
          <polygon points="600,272 568,170 600,196 632,170" fill="var(--cover-accent)" fill-opacity="0.26" />
          <circle cx="600" cy="190" r="10" fill="var(--cover-accent)" />
        </g>
      )
    }

    {
      motif === 'personas' && (
        <g>
          <g stroke="var(--cover-accent)" stroke-opacity="0.28" stroke-width="2.5">
            <path d="M600 96 V284" />
            <path d="M466 190 H734" />
          </g>
          <g fill="var(--cover-accent)">
            <circle cx="524" cy="142" r="36" fill-opacity="0.72" />
            <circle cx="676" cy="142" r="36" fill-opacity="0.48" />
            <circle cx="524" cy="238" r="36" fill-opacity="0.34" />
            <circle cx="676" cy="238" r="36" fill-opacity="0.56" />
          </g>
        </g>
      )
    }

    {
      motif === 'pyramid' && (
        <g fill="var(--cover-accent)" stroke="var(--bg-elev)" stroke-width="4" stroke-linejoin="round">
          <polygon points="600,72 642,118 558,118" fill-opacity="0.72" />
          <polygon points="558,118 642,118 682,166 518,166" fill-opacity="0.6" />
          <polygon points="518,166 682,166 722,214 478,214" fill-opacity="0.48" />
          <polygon points="478,214 722,214 762,262 438,262" fill-opacity="0.36" />
          <polygon points="438,262 762,262 802,310 398,310" fill-opacity="0.26" />
        </g>
      )
    }

    {
      motif === 'steps' && (
        <g>
          <g fill="var(--cover-accent)" stroke="var(--bg-elev)" stroke-width="4">
            <rect x="290" y="280" width="118" height="60" fill-opacity="0.3" />
            <rect x="410" y="244" width="118" height="96" fill-opacity="0.42" />
            <rect x="530" y="208" width="118" height="132" fill-opacity="0.54" />
            <rect x="650" y="172" width="118" height="168" fill-opacity="0.64" />
            <rect x="770" y="136" width="118" height="204" fill-opacity="0.74" />
          </g>
          <g fill="none" stroke="var(--cover-accent)" stroke-opacity="0.6" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M330 250 Q600 205 880 96" />
            <path d="M846 92 L884 92 L884 130" />
          </g>
        </g>
      )
    }
    {
      motif === 'assist' && (
        <g>
          <g fill="none" stroke="var(--cover-accent)" stroke-width="5" stroke-opacity="0.45" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="440,120 355,190 440,260" />
            <polyline points="760,120 845,190 760,260" />
          </g>
          <g fill="var(--cover-accent)">
            <path
              d="M600 108 C612 158 642 188 692 200 C642 212 612 242 600 292 C588 242 558 212 508 200 C558 188 588 158 600 108 Z"
              fill-opacity="0.72"
            />
            <path
              d="M712 116 C717 138 729 150 751 155 C729 160 717 172 712 194 C707 172 695 160 673 155 C695 150 707 138 712 116 Z"
              fill-opacity="0.4"
            />
          </g>
        </g>
      )
    }

    {
      motif === 'training' && (
        <g>
          <g fill="none" stroke="var(--cover-accent)" stroke-width="2.5" stroke-opacity="0.35">
            <path d="M330 90 V300 H900" stroke-linecap="round" />
          </g>
          <path
            d="M356 118 H900"
            stroke="var(--cover-accent)"
            stroke-width="2"
            stroke-opacity="0.4"
            stroke-dasharray="5 9"
            fill="none"
          />
          <path
            d="M356 128 C452 258 536 286 632 292 C728 296 812 294 884 292"
            fill="none"
            stroke="var(--cover-accent)"
            stroke-width="4"
            stroke-opacity="0.85"
            stroke-linecap="round"
          />
          <g fill="var(--cover-accent)">
            <circle cx="356" cy="128" r="10" fill-opacity="0.75" />
            <circle cx="600" cy="288" r="9" fill-opacity="0.6" />
            <circle cx="884" cy="292" r="12" fill-opacity="0.7" />
          </g>
        </g>
      )
    }

    {
      motif === 'speed' && (
        <g>
          <path
            d="M420 292 A190 190 0 0 1 780 292"
            fill="none"
            stroke="var(--cover-accent)"
            stroke-width="11"
            stroke-opacity="0.32"
            stroke-linecap="round"
          />
          <g fill="var(--cover-accent)">
            <circle cx="428" cy="286" r="7" fill-opacity="0.5" />
            <circle cx="474" cy="176" r="7" fill-opacity="0.5" />
            <circle cx="600" cy="128" r="7" fill-opacity="0.5" />
            <circle cx="726" cy="176" r="7" fill-opacity="0.5" />
            <circle cx="772" cy="286" r="7" fill-opacity="0.5" />
          </g>
          <path
            d="M600 286 L716 158"
            fill="none"
            stroke="var(--cover-accent)"
            stroke-width="5"
            stroke-opacity="0.85"
            stroke-linecap="round"
          />
          <circle cx="600" cy="286" r="15" fill="var(--cover-accent)" fill-opacity="0.85" />
        </g>
      )
    }

    {
      motif === 'agent' && (
        <g>
          <g
            fill="none"
            stroke="var(--cover-accent)"
            stroke-width="2.5"
            stroke-opacity="0.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M470 190 H372" />
            <path d="M730 190 H828" />
            <path d="M600 250 V298" />
            <path d="M384 180 L372 190 L384 200" />
            <path d="M816 180 L828 190 L816 200" />
            <path d="M590 288 L600 300 L610 288" />
          </g>
          <rect x="470" y="150" width="260" height="82" rx="18" fill="var(--cover-accent)" fill-opacity="0.62" />
          <g fill="var(--bg-elev)">
            <circle cx="560" cy="191" r="12" />
            <circle cx="640" cy="191" r="12" />
          </g>
          <g fill="var(--cover-accent)" fill-opacity="0.5">
            <rect x="252" y="164" width="112" height="52" rx="11" />
            <rect x="836" y="164" width="112" height="52" rx="11" />
            <rect x="540" y="300" width="120" height="50" rx="11" />
          </g>
        </g>
      )
    }

    {
      motif === 'scales' && (
        <g>
          <g fill="none" stroke="var(--cover-accent)" stroke-width="2.5" stroke-linecap="round">
            <path d="M378 138 H822" stroke-opacity="0.7" />
            <path d="M600 138 V300" stroke-opacity="0.5" />
            <path d="M540 302 H660" stroke-opacity="0.5" />
            <g stroke-opacity="0.4">
              <path d="M378 138 L338 212" />
              <path d="M378 138 L418 212" />
              <path d="M822 138 L782 212" />
              <path d="M822 138 L862 212" />
            </g>
            <path d="M330 210 A54 42 0 0 0 426 210" stroke-opacity="0.7" />
            <path d="M774 210 A54 42 0 0 0 870 210" stroke-opacity="0.7" />
          </g>
          <g fill="var(--cover-accent)">
            <circle cx="600" cy="126" r="13" fill-opacity="0.8" />
            <circle cx="378" cy="138" r="7" fill-opacity="0.6" />
            <circle cx="822" cy="138" r="7" fill-opacity="0.6" />
          </g>
        </g>
      )
    }

    {
      motif === 'mirror' && (
        <g>
          {/* Two sides of a negotiation, each echoing the other. Kept inside
              x 330-870 so nothing clips at the 16/10 list-thumbnail crop,
              which only shows x 296-904 of this viewBox. */}
          <g fill="var(--cover-accent)" stroke="none">
            <rect x="330" y="138" width="200" height="96" rx="18" fill-opacity="0.45" />
            <rect x="670" y="138" width="200" height="96" rx="18" fill-opacity="0.28" />
            <path d="M366 234 L350 270 L398 234" fill-opacity="0.45" />
            <path d="M834 234 L850 270 L802 234" fill-opacity="0.28" />
          </g>
          <g fill="none" stroke="var(--cover-accent)" stroke-width="2.5" stroke-linecap="round">
            {/* the line they talk across */}
            <path d="M600 108 V272" stroke-opacity="0.25" stroke-dasharray="7 13" />
            {/* nested echo arcs, each side mirroring the other about x=600 */}
            <g stroke-opacity="0.5">
              <path d="M548 172 A 34 34 0 0 1 548 238" />
              <path d="M652 172 A 34 34 0 0 0 652 238" />
            </g>
            <g stroke-opacity="0.28">
              <path d="M548 152 A 56 56 0 0 1 548 258" />
              <path d="M652 152 A 56 56 0 0 0 652 258" />
            </g>
          </g>
        </g>
      )
    }

    {
      motif === 'cycle' && (
        <g>
          <g fill="none" stroke="var(--cover-accent)" stroke-width="4" stroke-opacity="0.72" stroke-linecap="round" stroke-linejoin="round">
            <path d="M704 130 A122 122 0 1 0 704 250" />
            <path d="M704 130 L668 122 M704 130 L697 165" />
          </g>
          <g fill="var(--cover-accent)">
            <circle cx="600" cy="68" r="14" fill-opacity="0.78" />
            <circle cx="722" cy="190" r="14" fill-opacity="0.55" />
            <circle cx="600" cy="312" r="14" fill-opacity="0.55" />
            <circle cx="478" cy="190" r="14" fill-opacity="0.55" />
            <circle cx="600" cy="190" r="10" fill-opacity="0.9" />
          </g>
        </g>
      )
    }

    {
      motif === 'lever' && (
        <g>
          {/* Kept within x 350–845: the 16/10 list thumbnail slices to x 296–904. */}
          <g fill="none" stroke="var(--cover-accent)" stroke-width="2.5" stroke-linecap="round">
            {/* the beam, pivoting well off-centre: long effort arm, short load arm */}
            <path d="M360 248 L840 152" stroke-opacity="0.75" />
            {/* where the beam swings to — force applied without force */}
            <path d="M353 196 L842 168" stroke-opacity="0.3" stroke-dasharray="7 12" />
            {/* fulcrum */}
            <path d="M730 172 L770 254 H690 Z" stroke-opacity="0.7" />
            <path d="M662 256 H798" stroke-opacity="0.45" />
            {/* the small effort at the far end of the long arm */}
            <path d="M360 200 V236" stroke-opacity="0.6" />
            <path d="M352 228 L360 238 L368 228" stroke-opacity="0.6" />
          </g>
          <g fill="var(--cover-accent)" stroke="none">
            {/* the load: heavy, close in, barely has to move */}
            <rect x="771" y="114" width="58" height="44" rx="7" fill-opacity="0.5" />
            <circle cx="360" cy="248" r="12" fill-opacity="0.8" />
            <circle cx="730" cy="172" r="7" fill-opacity="0.85" />
          </g>
        </g>
      )
    }

    {
      motif === 'bootstrap' && (
        <g>
          {/* Kept within x 350–845: the 16/10 list thumbnail slices to x 296–904. */}
          <g fill="none" stroke="var(--cover-accent)" stroke-width="2.5" stroke-linecap="round">
            {/* the loop that would deploy itself — deliberately left open.
                Four quarter arcs (small-arc flag 0) rather than one large arc, so the
                centre is unambiguous at 110,110 around (660,190). */}
            <path
              d="M557 152 A110 110 0 0 1 660 80 A110 110 0 0 1 770 190 A110 110 0 0 1 660 300 A110 110 0 0 1 557 228"
              stroke-opacity="0.7"
            />
            {/* fed from outside the loop instead */}
            <path d="M404 190 H536" stroke-opacity="0.6" />
            <path d="M527 182 L537 190 L527 198" stroke-opacity="0.6" />
          </g>
          <g fill="var(--cover-accent)" stroke="none">
            {/* the separate system doing the applying */}
            <rect x="352" y="168" width="52" height="44" rx="8" fill-opacity="0.5" />
            {/* stages around the loop */}
            <circle cx="660" cy="80" r="11" fill-opacity="0.6" />
            <circle cx="770" cy="190" r="11" fill-opacity="0.6" />
            <circle cx="660" cy="300" r="11" fill-opacity="0.6" />
            {/* the open ends of the loop */}
            <circle cx="557" cy="152" r="7" fill-opacity="0.85" />
            <circle cx="557" cy="228" r="7" fill-opacity="0.85" />
          </g>
        </g>
      )
    }
  </svg>
</div>

<style>
  .cover {
    /* Default hue; section tints override via .tint-* in global.css. */
    --cover-accent: var(--accent);
    width: 100%;
    aspect-ratio: 1200 / 380;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .cover svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
