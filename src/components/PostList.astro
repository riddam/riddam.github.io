---
import Cover from './Cover.astro';
import type { Motif, SectionId } from '../motifs';

interface PostItem {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  sectionLabel?: string;
  sectionId?: SectionId;
  minutesRead?: number;
  cover?: Motif;
  coverVariant?: 1 | 2;
}

interface Props {
  posts: PostItem[];
}

const { posts } = Astro.props;

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li class:list={{ 'has-thumb': post.cover }}>
        {post.cover && (
          <a class="post-thumb-link" href={post.href} tabindex="-1" aria-hidden="true">
            <Cover motif={post.cover} tint={post.sectionId} variant={post.coverVariant} class="post-thumb" />
          </a>
        )}
        <div class="post-list-body">
          <p class="list-meta">
            <time datetime={post.pubDate.toISOString()}>{formatDate(post.pubDate)}</time>
            {post.sectionLabel && (
              <>
                <span>·</span>
                <span class="section-badge">{post.sectionLabel}</span>
              </>
            )}
            {post.minutesRead && (
              <>
                <span>·</span>
                <span>{post.minutesRead} min read</span>
              </>
            )}
          </p>
          <div class="post-title">
            <a href={post.href}>{post.title}</a>
          </div>
          <p class="excerpt">{post.description}</p>
        </div>
      </li>
    ))
  }
</ul>
