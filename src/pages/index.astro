---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import Cover from '../components/Cover.astro';
import { SITE_DESCRIPTION, SECTIONS } from '../consts';
import { readingStats } from '../utils/reading-time';

const posts = (
  await Promise.all(
    SECTIONS.map(async (section) => {
      const entries = await getCollection(section.id, ({ data }) => !data.draft);
      return entries.map((entry) => ({
        href: `/${section.id}/${entry.id}/`,
        title: entry.data.title,
        description: entry.data.description,
        pubDate: entry.data.pubDate,
        sectionLabel: section.label,
        sectionId: section.id,
        minutesRead: readingStats(entry.body ?? '').minutes,
        cover: entry.data.cover,
        coverVariant: entry.data.coverVariant,
      }));
    })
  )
)
  .flat()
  .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

const [featured, ...rest] = posts;

const HOME_LIMIT = 8;
const recent = rest.slice(0, HOME_LIMIT);
const hasMore = rest.length > HOME_LIMIT;

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base description={SITE_DESCRIPTION}>
  <div class="hero">
    <h1>Hi, I'm Riddam.</h1>
    <p>
      Staff engineer in Amsterdam, working in cloud and application architecture.
      I build systems that hold up in production, read books worth remembering, and
      think about how to lead engineers well — and I write it all down here.
    </p>
  </div>

  {
    featured && (
      <>
        <p class="home-heading">Latest</p>
        <a class="featured" href={featured.href}>
          {featured.cover && <Cover motif={featured.cover} tint={featured.sectionId} variant={featured.coverVariant} class="featured-cover" />}
          <p class="list-meta">
            <time datetime={featured.pubDate.toISOString()}>
              {formatDate(featured.pubDate)}
            </time>
            <span>·</span>
            <span class="section-badge">{featured.sectionLabel}</span>
            {featured.minutesRead && (
              <>
                <span>·</span>
                <span>{featured.minutesRead} min read</span>
              </>
            )}
          </p>
          <h3>{featured.title}</h3>
          <p>{featured.description}</p>
        </a>
      </>
    )
  }

  {
    recent.length > 0 && (
      <>
        <p class="home-heading">More writing</p>
        <PostList posts={recent} />
        {hasMore && (
          <p class="home-more">
            <a href="/archive/">Browse all {posts.length} posts →</a>
          </p>
        )}
      </>
    )
  }

  <p class="home-heading">Explore</p>
  <ul class="section-grid">
    {
      SECTIONS.map((section) => (
        <li>
          <a href={`/${section.id}/`} class="section-card">
            <strong>{section.label}</strong>
            <span>{section.description}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .featured-cover {
    margin-bottom: 1.1rem;
  }
  .home-more {
    margin: 1.5rem 0 0;
    font-size: 0.95rem;
    font-weight: 600;
  }
</style>
