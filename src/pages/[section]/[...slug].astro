---
import { getCollection, render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { SECTIONS, SERIES } from '../../consts';
import { readingStats } from '../../utils/reading-time';

export async function getStaticPaths() {
  const paths = [];
  for (const section of SECTIONS) {
    const entries = await getCollection(section.id, ({ data }) => !data.draft);
    for (const entry of entries) {
      paths.push({
        params: { section: section.id, slug: entry.id },
        props: { entry, section },
      });
    }
  }
  return paths;
}

const { entry, section } = Astro.props;
const { Content, headings } = await render(entry);

const { words, minutes: minutesRead } = readingStats(entry.body ?? '');

// Gather every published post across sections, tagged with its section label.
const all = [];
for (const s of SECTIONS) {
  const entries = await getCollection(s.id, ({ data }) => !data.draft);
  for (const e of entries) {
    all.push({
      id: e.id,
      sectionId: s.id,
      href: `/${s.id}/${e.id}/`,
      title: e.data.title,
      description: e.data.description,
      pubDate: e.data.pubDate,
      tags: e.data.tags ?? [],
      sectionLabel: s.label,
      minutesRead: readingStats(e.body ?? '').minutes,
    });
  }
}

const currentTags = new Set(entry.data.tags ?? []);
const candidates = all.filter(
  (p) => !(p.sectionId === section.id && p.id === entry.id)
);

// Rank by shared tags, then same section, then recency.
const related = candidates
  .map((p) => ({
    ...p,
    score:
      p.tags.filter((t) => currentTags.has(t)).length * 10 +
      (p.sectionId === section.id ? 3 : 0),
  }))
  .sort(
    (a, b) => b.score - a.score || b.pubDate.valueOf() - a.pubDate.valueOf()
  )
  .slice(0, 3);

// If this post belongs to a curated series, build ordered navigation for it.
const seriesDef = SERIES.find(
  (s) => s.sectionId === section.id && s.slugs.includes(entry.id)
);
const series = seriesDef
  ? {
      title: seriesDef.title,
      current: seriesDef.slugs.indexOf(entry.id) + 1,
      total: seriesDef.slugs.length,
      items: seriesDef.slugs.map((slug, i) => ({
        order: i + 1,
        href: `/${seriesDef.sectionId}/${slug}/`,
        title:
          all.find((p) => p.sectionId === seriesDef.sectionId && p.id === slug)
            ?.title ?? slug,
        current: slug === entry.id,
      })),
    }
  : undefined;

// Previous / next within the same section, ordered oldest → newest.
const sectionPosts = all
  .filter((p) => p.sectionId === section.id)
  .sort((a, b) => a.pubDate.valueOf() - b.pubDate.valueOf());
const idx = sectionPosts.findIndex((p) => p.id === entry.id);
const olderPost = idx > 0 ? sectionPosts[idx - 1] : undefined;
const newerPost =
  idx >= 0 && idx < sectionPosts.length - 1 ? sectionPosts[idx + 1] : undefined;
const toNav = (p?: (typeof sectionPosts)[number]) =>
  p ? { href: p.href, title: p.title } : undefined;
---

<Post
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  tags={entry.data.tags}
  section={section}
  minutesRead={minutesRead}
  wordCount={words}
  headings={headings}
  ogImage={`/og/${section.id}/${entry.id}.png`}
  related={related}
  series={series}
  olderPost={toNav(olderPost)}
  newerPost={toNav(newerPost)}
  cover={entry.data.cover}
>
  <Content />
</Post>
