---
import Base from './Base.astro';
import PostList from '../components/PostList.astro';
import Cover from '../components/Cover.astro';
import {
  SITE_TITLE,
  AUTHOR_ROLE,
  AUTHOR_LOCATION,
  AUTHOR_BLURB,
  LINKEDIN_URL,
  GITHUB_URL,
} from '../consts';
import type { Section } from '../consts';
import type { Motif, SectionId } from '../motifs';
import type { MarkdownHeading } from 'astro';

interface RelatedPost {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  sectionLabel?: string;
  sectionId?: SectionId;
  cover?: Motif;
  coverVariant?: 1 | 2;
}

interface SeriesNav {
  title: string;
  current: number;
  total: number;
  items: { order: number; href: string; title: string; current: boolean }[];
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  section: Section;
  minutesRead?: number;
  wordCount?: number;
  headings?: MarkdownHeading[];
  ogImage?: string;
  related?: RelatedPost[];
  series?: SeriesNav;
  olderPost?: { href: string; title: string };
  newerPost?: { href: string; title: string };
  cover?: Motif;
  coverVariant?: 1 | 2;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  section,
  minutesRead,
  wordCount,
  headings = [],
  ogImage,
  related = [],
  series,
  olderPost,
  newerPost,
  cover,
  coverVariant,
} = Astro.props;

// h2 + h3: the long guides carry their real structure at depth 3.
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);
// Still gate on top-level sections, so a post with one h2 and four h3s
// doesn't sprout a sidebar.
const showToc = tocItems.filter((h) => h.depth === 2).length >= 3;

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const shareUrl = new URL(Astro.url.pathname, Astro.site).href;
const xShareUrl = `https://x.com/intent/tweet?text=${encodeURIComponent(
  title
)}&url=${encodeURIComponent(shareUrl)}`;
const liShareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(
  shareUrl
)}`;
---

<Base
  title={title}
  description={description}
  wide={showToc}
  ogImage={ogImage}
  article={{
    pubDate,
    updatedDate,
    tags,
    section: section.label,
    sectionId: section.id,
    wordCount,
  }}
>
  <div class="reading-progress" id="reading-progress"></div>
  <div class:list={['post-grid', { 'has-toc': showToc }]}>
    <article data-pagefind-body>
      <aside class="share-rail" data-pagefind-ignore data-share data-share-url={shareUrl} data-share-title={title} aria-label="Share this post">
        <div class="share-rail-inner">
          <span class="share-rail-label">Share</span>
          <button type="button" class="rail-btn" data-action="copy" aria-label="Copy link to this post">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          </button>
          <button type="button" class="rail-btn" data-action="native" aria-label="Share via your device" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
          </button>
          <a class="rail-btn" href={xShareUrl} target="_blank" rel="noopener noreferrer" aria-label="Share on X">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a class="rail-btn" href={liShareUrl} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>
          </a>
        </div>
      </aside>
      <div class="post-header">
        {cover && <Cover motif={cover} tint={section.id} variant={coverVariant} class="post-cover" />}
        <a href={`/${section.id}/`} class="section-badge">{section.label}</a>
        <h1>{title}</h1>
        <p class="post-description">{description}</p>
        <p class="byline">
          By <a href="/about/">{SITE_TITLE}</a> · {AUTHOR_ROLE}
        </p>
        <p class="post-meta">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {
            updatedDate && (
              <>
                <span class="dot">·</span>
                <span>Updated {formatDate(updatedDate)}</span>
              </>
            )
          }
          {
            minutesRead && (
              <>
                <span class="dot">·</span>
                <span>{minutesRead} min read</span>
              </>
            )
          }
        </p>
        {
          tags.length > 0 && (
            <div class="tags">
              {tags.map((tag) => (
                <a class="tag" href={`/tags/${tag}/`}>
                  {tag}
                </a>
              ))}
            </div>
          )
        }
      </div>
      <hr class="post-divider" />
      {
        series && (
          <nav class="series-box" data-pagefind-ignore aria-label="Series navigation">
            <p class="series-eyebrow">
              Part {series.current} of {series.total} · Series
            </p>
            <p class="series-title">{series.title}</p>
            <ol class="series-list">
              {series.items.map((it) => (
                <li class:list={['series-item', { current: it.current }]}>
                  {it.current ? (
                    <span aria-current="true">{it.title}</span>
                  ) : (
                    <a href={it.href}>{it.title}</a>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <slot />

      <div class="share-row" data-pagefind-ignore data-share data-share-url={shareUrl} data-share-title={title}>
        <span class="share-label">Share</span>
        <button type="button" class="share-btn" data-action="copy" aria-label="Copy link to this post">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          <span class="share-btn-label">Copy link</span>
        </button>
        <button type="button" class="share-btn" data-action="native" aria-label="Share via your device" hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
          <span>Share…</span>
        </button>
        <a class="share-btn" href={xShareUrl} target="_blank" rel="noopener noreferrer" aria-label="Share on X">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          <span>X</span>
        </a>
        <a class="share-btn" href={liShareUrl} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>
          <span>LinkedIn</span>
        </a>
      </div>

      <footer class="author-card" data-pagefind-ignore>
        <p class="author-name">{SITE_TITLE}</p>
        <p class="author-role">{AUTHOR_ROLE} · {AUTHOR_LOCATION}</p>
        <p class="author-blurb">{AUTHOR_BLURB} If this was useful, let's connect.</p>
        <p class="author-links">
          <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <span class="dot">·</span>
          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
          <span class="dot">·</span>
          <a href="/about/">About</a>
        </p>
      </footer>

      {
        related.length > 0 && (
          <section class="related" data-pagefind-ignore>
            <h2>Keep reading</h2>
            <PostList posts={related} />
          </section>
        )
      }

      {
        (olderPost || newerPost) && (
          <nav class="post-nav" data-pagefind-ignore aria-label="More in this section">
            {olderPost ? (
              <a class="post-nav-link prev" href={olderPost.href} rel="prev">
                <span class="post-nav-dir">← Previous</span>
                <span class="post-nav-title">{olderPost.title}</span>
              </a>
            ) : (
              <span />
            )}
            {newerPost ? (
              <a class="post-nav-link next" href={newerPost.href} rel="next">
                <span class="post-nav-dir">Next →</span>
                <span class="post-nav-title">{newerPost.title}</span>
              </a>
            ) : (
              <span />
            )}
          </nav>
        )
      }
    </article>

    {
      showToc && (
        <aside class="toc" data-pagefind-ignore aria-label="Table of contents">
          <nav>
            <p class="toc-title">On this page</p>
            <ul>
              {tocItems.map((h) => (
                <li class:list={[`toc-d${h.depth}`]}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
  </div>
</Base>

<style>
  .share-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 2.75rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .share-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--text-muted);
    margin-right: 0.3rem;
  }
  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.8rem;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .share-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .share-btn.copied {
    color: var(--accent);
    border-color: var(--accent);
  }
  .share-btn svg {
    width: 0.95rem;
    height: 0.95rem;
    flex-shrink: 0;
  }

  /* ---------- Series box ---------- */
  .series-box {
    margin: 0 0 2rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--accent-soft);
  }
  .series-eyebrow {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  .series-title {
    margin: 0.15rem 0 0.65rem;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--text);
  }
  .series-list {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: series;
  }
  .series-item {
    counter-increment: series;
    display: flex;
    gap: 0.5rem;
    margin: 0.3rem 0;
    font-size: 0.93rem;
    line-height: 1.45;
  }
  .series-item::before {
    content: counter(series) '.';
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .series-item a {
    color: var(--accent);
    text-decoration: none;
  }
  .series-item a:hover {
    text-decoration: underline;
  }
  .series-item.current {
    color: var(--text);
    font-weight: 600;
  }
  .series-item.current span::after {
    content: ' — you are here';
    color: var(--text-muted);
    font-weight: 400;
    font-size: 0.85em;
  }

  /* ---------- Cover art ---------- */
  .post-cover {
    margin-bottom: 1.5rem;
  }

  /* ---------- Previous / next post nav ---------- */
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
  }
  .post-nav-link:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lift);
  }
  .post-nav-link.next {
    text-align: right;
    align-items: flex-end;
  }
  .post-nav-dir {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }
  .post-nav-title {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--text);
  }
  @media (max-width: 34rem) {
    .post-nav {
      grid-template-columns: 1fr;
    }
    .post-nav-link.next {
      text-align: left;
      align-items: flex-start;
    }
  }

  /* ---------- Sticky vertical share rail (wide screens only) ---------- */
  .share-rail {
    display: none;
  }
  @media (min-width: 1240px) {
    article {
      position: relative;
    }
    .share-rail {
      display: block;
      position: absolute;
      top: 0;
      left: -4.75rem;
      height: 100%;
      width: 3rem;
    }
    .share-rail-inner {
      position: sticky;
      top: 6.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }
    .share-rail-label {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      font-size: 0.62rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: var(--text-muted);
      margin-bottom: 0.4rem;
    }
    .rail-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.4rem;
      height: 2.4rem;
      color: var(--text-muted);
      background: var(--bg-elev);
      border: 1px solid var(--border);
      border-radius: 999px;
      cursor: pointer;
      text-decoration: none;
      transition: color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
    }
    .rail-btn:hover {
      color: var(--accent);
      border-color: var(--accent);
      transform: translateY(-1px);
    }
    .rail-btn.copied {
      color: var(--accent);
      border-color: var(--accent);
    }
    .rail-btn[hidden] {
      display: none;
    }
    .rail-btn svg {
      width: 1rem;
      height: 1rem;
    }
    /* The rail covers sharing on wide screens; drop the inline row to avoid dupes. */
    .share-row {
      display: none;
    }
  }
</style>

<script>
  // Wire every share container (inline row + sticky rail): reveal native share
  // where supported, and copy-to-clipboard with brief feedback.
  document.querySelectorAll<HTMLElement>('[data-share]').forEach((box) => {
    const url = box.dataset.shareUrl || location.href;
    const title = box.dataset.shareTitle || document.title;

    const nativeBtn = box.querySelector<HTMLButtonElement>('[data-action="native"]');
    if (nativeBtn && 'share' in navigator) {
      nativeBtn.hidden = false;
      nativeBtn.addEventListener('click', () => {
        navigator.share({ title, url }).catch(() => {});
      });
    }

    const copyBtn = box.querySelector<HTMLButtonElement>('[data-action="copy"]');
    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        copyBtn.classList.add('copied');
        const label = copyBtn.querySelector<HTMLElement>('.share-btn-label');
        const original = label?.textContent ?? null;
        if (label) label.textContent = 'Copied';
        setTimeout(() => {
          copyBtn.classList.remove('copied');
          if (label && original !== null) label.textContent = original;
        }, 1500);
      } catch {
        /* clipboard unavailable — the share links still work */
      }
    });
  });
</script>

<script>
  // Reading progress bar tied to scroll position.
  const bar = document.getElementById('reading-progress');
  if (bar) {
    const update = () => {
      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      const pct = max > 0 ? (h.scrollTop / max) * 100 : 0;
      bar.style.width = pct + '%';
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }
</script>

<script>
  // Highlight the TOC entry for the section currently in view. Driven by scroll
  // position (last heading above the offset) so it stays correct scrolling both
  // down and up — an intersection-only approach leaves stale/no active entry.
  const toc = document.querySelector('.toc');
  if (toc) {
    const links = new Map(
      [...toc.querySelectorAll('a')].map((a) => [
        decodeURIComponent(a.hash.slice(1)),
        a,
      ])
    );
    const headings = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    const OFFSET = 100; // account for the sticky header
    const setActive = () => {
      let currentId = headings[0]?.id;
      for (const h of headings) {
        if (h.getBoundingClientRect().top - OFFSET <= 0) currentId = h.id;
        else break;
      }
      links.forEach((a, id) => {
        const on = id === currentId;
        a.classList.toggle('active', on);
        if (on && a.scrollIntoView) {
          // Scrolls only the nearest scrollable ancestor (the sticky .toc nav)
          // and is a no-op when already visible, so it won't fight the page
          // scroll. No `behavior: 'smooth'` — this fires on every scroll event.
          a.scrollIntoView({ block: 'nearest' });
        }
      });
    };

    setActive();
    window.addEventListener('scroll', setActive, { passive: true });
    window.addEventListener('resize', setActive);
  }
</script>
